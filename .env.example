# nuni track - 환경 변수 예시
# 이 파일을 .env로 복사한 뒤 실제 서버 URL을 입력하세요.
#
# EXPO_PUBLIC_API_BASE_URL: 기록 동기화 REST API의 기본 URL
# 예: https://api.example.com
# 비워두면 클라우드 동기화를 사용하지 않고 기기 저장만 사용합니다.

EXPO_PUBLIC_API_BASE_URL=

# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID: Google Web OAuth Client ID
# Google 로그인 초기화와 서버 ID Token audience 검증에 사용합니다.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=199651041375-2n6bfjj3up0pc5hi0aa7nb0254942m31.apps.googleusercontent.com

# EXPO_PUBLIC_MAP_STYLE_URL: MapLibre 지도 스타일 URL
# 비워두면 OpenFreeMap liberty(밝은) 스타일을 사용합니다.
# API 키가 필요하지 않습니다.
EXPO_PUBLIC_MAP_STYLE_URL=
