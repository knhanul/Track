{
  "cli": { "version": ">= 16.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": ""
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": ""
      }
    },
    "production": {
      "channel": "production",
      "credentialsSource": "remote",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": ""
      }
    }
  }
}
