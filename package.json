{
  "name": "nuni-track-native",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "setup:modules": "npx expo install expo-location expo-task-manager expo-sqlite expo-network expo-crypto",
    "doctor": "npx expo-doctor",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "^11.3.6",
    "expo": "~56.0.18",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.24",
    "expo-keep-awake": "~56.0.3",
    "expo-location": "~56.0.22",
    "expo-network": "~56.0.5",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.14",
    "expo-sqlite": "~56.0.5",
    "expo-task-manager": "~56.0.24",
    "lucide-react-native": "^1.27.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-nitro-google-signin": "^1.3.0",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "patch-package": "^8.0.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
